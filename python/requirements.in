babeldoc==0.6.4
# bitstring 5.0 removed BitStream, which babeldoc 0.6.4 imports
bitstring<5
# Newer releases of these have no wheels for Intel Macs running macOS 13.
# Both sides are needed, or uv picks the older version for every platform.
cryptography<49 ; sys_platform == 'darwin' and platform_machine == 'x86_64'
cryptography>=49 ; sys_platform != 'darwin' or platform_machine != 'x86_64'
onnxruntime<1.24 ; sys_platform == 'darwin' and platform_machine == 'x86_64'
onnxruntime>=1.24 ; sys_platform != 'darwin' or platform_machine != 'x86_64'
opencv-python-headless<4.12 ; sys_platform == 'darwin' and platform_machine == 'x86_64'
opencv-python-headless>=4.12 ; sys_platform != 'darwin' or platform_machine != 'x86_64'
pymupdf<2 ; sys_platform == 'darwin' and platform_machine == 'x86_64'
pymupdf>=2 ; sys_platform != 'darwin' or platform_machine != 'x86_64'
